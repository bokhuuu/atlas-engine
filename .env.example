# -----------------------------------------------------------------------
# Atlas - Local Development Environment
# Copy this to .env and fill in real values. Never commit .env itself.
# -----------------------------------------------------------------------


# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------

APP_NAME=Atlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_TIMEZONE=UTC


# -----------------------------------------------------------------------
# Localization
# -----------------------------------------------------------------------

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LARAKIT_DEFAULT_LOCALE=en


# -----------------------------------------------------------------------
# Maintenance Mode
# -----------------------------------------------------------------------

APP_MAINTENANCE_DRIVER=file
LARAKIT_MAINTENANCE_SECRET=


# -----------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------

BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

# Docker: DB_HOST=mysql, DB_PORT=3307
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=atlas
DB_USERNAME=root
DB_PASSWORD=


# -----------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# -----------------------------------------------------------------------
# Broadcasting / Filesystem / Queue
# -----------------------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis


# -----------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1


# -----------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------

# Docker: REDIS_HOST=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379


# -----------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SCRAPER_MAIL_TO=


# -----------------------------------------------------------------------
# AWS (optional - only needed if using S3 for media storage)
# -----------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# -----------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"


# -----------------------------------------------------------------------
# Laravel Telescope
# -----------------------------------------------------------------------

TELESCOPE_ENABLED=true
TELESCOPE_ACCESS_EMAIL=


# -----------------------------------------------------------------------
# LaraKit Notifications & Mail Content
# -----------------------------------------------------------------------

LARAKIT_NOTIFICATION_FOOTER="This is an automated notification from LaraKit."
LARAKIT_WELCOME_EMAIL_SUBJECT="Welcome to LaraKit"


# -----------------------------------------------------------------------
# Scraper - General
# -----------------------------------------------------------------------

SCRAPER_REQUEST_DELAY=2
SCRAPER_DELAY_JITTER=0.3
SCRAPER_BROWSER_LANGUAGES=en-US,en
SCRAPER_MAX_PAGES=50


# -----------------------------------------------------------------------
# Scraper - Browser
# -----------------------------------------------------------------------

# CHROMEDRIVER_URL is set by docker-compose.yml, not here.
BROWSER_CONNECT_TIMEOUT_MS=60000
BROWSER_REQUEST_TIMEOUT_MS=60000
ELEMENT_WAIT_TIMEOUT_S=10
BROWSER_WINDOW_SIZE=1920,1080
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"


# -----------------------------------------------------------------------
# Scraper - Retry
# -----------------------------------------------------------------------

SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY_MS=1000
SCRAPER_RETRY_BASE_DELAY=30


# -----------------------------------------------------------------------
# Scraper - Queue
# -----------------------------------------------------------------------

SCRAPER_CONCURRENCY=3
SCRAPER_RETRY_TIMES=3
SCRAPER_TIMEOUT_S=60
SCRAPER_RATE_LIMIT_WINDOW=1
SCRAPER_RATE_LIMIT_RELEASE=5

SCRAPER_BATCH_NAME_PATTERN="{source}-run-{id}"


# -----------------------------------------------------------------------
# Scraper - list.am Login
# -----------------------------------------------------------------------

LISTAM_EMAIL=
LISTAM_PASSWORD=


# -----------------------------------------------------------------------
# Scraper - Notifications (Telegram, Mail)
# -----------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------
# Scraper - Export
# -----------------------------------------------------------------------

SCRAPER_EXPORT_PATH=exports


# -----------------------------------------------------------------------
# Scraper - Proxy
# -----------------------------------------------------------------------

SCRAPER_PROXY_ENABLED=false
SCRAPER_PROXY_STRATEGY=round_robin
SCRAPER_PROXIES=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=


# -----------------------------------------------------------------------
# API Rate Limiting
# -----------------------------------------------------------------------

API_RATE_LIMIT=60
API_PER_TOKEN_LIMIT=30


# -----------------------------------------------------------------------
# Scraper - Drift Detection
# -----------------------------------------------------------------------

SCRAPER_DRIFT_MIN_LISTINGS=10
SCRAPER_DRIFT_MAX_NULL_RATE=0.5

# -----------------------------------------------------------------------
# Scraper - Cross-Poster Duplicate Detection
# -----------------------------------------------------------------------

# Flags (does not delete) probable duplicate listings - the same
# physical property posted by different parties under different
# external_ids. District/floor/rooms must match exactly; area and
# price are checked within these tolerances. See ATLAS.md for the
# real-data analysis these thresholds came from.
DUPLICATE_DETECTION_ENABLED=true
DUPLICATE_AREA_TOLERANCE_PERCENT=5.0
DUPLICATE_PRICE_TOLERANCE_PERCENT=10.0
DUPLICATE_AREA_TOLERANCE_PERCENT_STRICT=3.0
DUPLICATE_PRICE_TOLERANCE_PERCENT_STRICT=6.0


# -----------------------------------------------------------------------
# Sentry (Error Tracking)
# -----------------------------------------------------------------------

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------
# AI - Provider
# Atlas uses OpenRouter for all environments — routes to Anthropic,
# OpenAI, Google and others from a single API key.
# -----------------------------------------------------------------------

AI_DEFAULT_PROVIDER=openrouter
AI_PRODUCTION_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key-here


# -----------------------------------------------------------------------
# AI - Models
# agent: claude-haiku-4-5 — reliable tool-calling with optional parameters.
# text/tools: gemini-2.5-flash-lite — fast, cheap for text generation.
# embeddings: text-embedding-3-small — deferred to Thread 6 (RAG).
# vision: gemini-2.5-flash-lite — deferred to Thread 6 (PDF/image upload).
# -----------------------------------------------------------------------

AI_AGENT_MODEL=anthropic/claude-haiku-4-5
AI_TEXT_MODEL=google/gemini-2.5-flash-lite
AI_TOOLS_MODEL=google/gemini-2.5-flash-lite
AI_EMBEDDINGS_MODEL=openai/text-embedding-3-small
AI_VISION_MODEL=google/gemini-2.5-flash-lite

AI_FALLBACK_PRIMARY_MODEL=anthropic/claude-haiku-4-5
AI_FALLBACK_SECONDARY_MODEL=openrouter/auto


# -----------------------------------------------------------------------
# AI - Performance & Limits
# -----------------------------------------------------------------------

AI_CACHE_TTL=3600
AI_SEARCH_LIMIT=5
AI_MAX_TOKENS=4096
AI_RETRY_TIMES=3
AI_RETRY_SLEEP_MS=1000
AI_DEFAULT_SYSTEM_PROMPT="You are a real estate market intelligence assistant."


# -----------------------------------------------------------------------
# AI - Cost Controls
# CostAlertListener sends Telegram + email when a single call exceeds threshold.
# TokenBudgetService blocks calls when monthly token budget is exhausted.
# -----------------------------------------------------------------------

AI_COST_ALERT_THRESHOLD=0.01
AI_MONTHLY_TOKEN_BUDGET=1000000
AI_TOKEN_BUDGET_ENABLED=true


# -----------------------------------------------------------------------
# AI - Rate Limits (calls per hour per user)
# -----------------------------------------------------------------------

AI_RATE_LIMIT_CHAT=30
AI_RATE_LIMIT_TEXT=50
AI_RATE_LIMIT_EMBED=100
AI_RATE_LIMIT_ANALYSIS=20


# -----------------------------------------------------------------------
# AI - Webhook
# HMAC-SHA256 secret for verifying incoming webhook requests.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------

WEBHOOK_SECRET=
WEBHOOK_MAX_FILE_SIZE_KB=10240