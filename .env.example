# -----------------------------------------------------------------------
# Atlas - Local Development Environment
# Copy this to .env and fill in real values. Never commit .env itself.
# -----------------------------------------------------------------------


# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------

APP_NAME=Atlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_TIMEZONE=UTC


# -----------------------------------------------------------------------
# Localization
# -----------------------------------------------------------------------

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LARAKIT_DEFAULT_LOCALE=en


# -----------------------------------------------------------------------
# Maintenance Mode
# -----------------------------------------------------------------------

APP_MAINTENANCE_DRIVER=file
LARAKIT_MAINTENANCE_SECRET=


# -----------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------

BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default market slug. Controls which market the app defaults to.
# Must match a key in config/scraper.php markets array.
DEFAULT_MARKET=yerevan


# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=atlas
DB_USERNAME=atlas
DB_PASSWORD=

PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Backblaze B2 Database Backups
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=bokhuuu-atlas-backups

B2_SCREENSHOTS_KEY_ID=
B2_SCREENSHOTS_APPLICATION_KEY=
B2_SCREENSHOTS_REGION=eu-central-003
B2_SCREENSHOTS_BUCKET=bokhuuu-atlas-screenshots
B2_SCREENSHOTS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com



# -----------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# -----------------------------------------------------------------------
# Broadcasting / Filesystem / Queue
# -----------------------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis


# -----------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1


# -----------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------

# Docker: REDIS_HOST=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379


# -----------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------
# AWS (optional - only needed if using S3 for media storage)
# -----------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# -----------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"


# -----------------------------------------------------------------------
# Laravel Telescope
# -----------------------------------------------------------------------

TELESCOPE_ENABLED=true
TELESCOPE_ACCESS_EMAIL=


# -----------------------------------------------------------------------
# LaraKit Notifications & Mail Content
# -----------------------------------------------------------------------

LARAKIT_NOTIFICATION_FOOTER="This is an automated notification from LaraKit."
LARAKIT_WELCOME_EMAIL_SUBJECT="Welcome to LaraKit"


# -----------------------------------------------------------------------
# Scraper - General
# -----------------------------------------------------------------------

SCRAPER_REQUEST_DELAY=2
SCRAPER_DELAY_JITTER=0.3
SCRAPER_BROWSER_LANGUAGES=en-US,en
SCRAPER_MAX_PAGES=50

SCRAPER_MAIL_TO=



# -----------------------------------------------------------------------
# Scraper - Browser
# -----------------------------------------------------------------------

# CHROMEDRIVER_URL is set by docker-compose.yml, not here.
BROWSER_CONNECT_TIMEOUT_MS=60000
BROWSER_REQUEST_TIMEOUT_MS=60000
ELEMENT_WAIT_TIMEOUT_S=10
BROWSER_WINDOW_SIZE=1920,1080
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"


# -----------------------------------------------------------------------
# Scraper - Retry
# -----------------------------------------------------------------------

SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY_MS=1000
SCRAPER_RETRY_BASE_DELAY=30


# -----------------------------------------------------------------------
# Scraper - Queue
# -----------------------------------------------------------------------

SCRAPER_CONCURRENCY=3
SCRAPER_RETRY_TIMES=3
SCRAPER_TIMEOUT_S=60
SCRAPER_RATE_LIMIT_WINDOW=1
SCRAPER_RATE_LIMIT_RELEASE=5

SCRAPER_BATCH_NAME_PATTERN="{source}-run-{id}"


# -----------------------------------------------------------------------
# Scraper - list.am Login
# -----------------------------------------------------------------------

LISTAM_EMAIL=
LISTAM_PASSWORD=

# -----------------------------------------------------------------------
# myhome.ge Tbilisi Market
# -----------------------------------------------------------------------
MYHOME_EMAIL=
MYHOME_PASSWORD=


# -----------------------------------------------------------------------
# Scraper - Notifications (Telegram, Mail)
# -----------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------
# Scraper - Export
# -----------------------------------------------------------------------

SCRAPER_EXPORT_PATH=exports


# -----------------------------------------------------------------------
# Scraper - Proxy (Webshare Rotating Residential)
# -----------------------------------------------------------------------

SCRAPER_PROXY_ENABLED=false  # Set to true in production for myhome.ge
SCRAPER_PROXY_STRATEGY=round_robin
SCRAPER_PROXIES=p.webshare.io:80
SCRAPER_PROXY_USERNAME=rbomxxeb-ge-rotate
SCRAPER_PROXY_PASSWORD=y64t6o22rr9i
PHONE_REVEAL_PROXY=http://username:password@p.webshare.io:80

# -----------------------------------------------------------------------
# Scraper - Listing Lifecycle Check 
# -----------------------------------------------------------------------

LISTING_CHECK_DAILY_PERCENT=5.0
LISTING_CHECK_DELAY_MS=2000

# -----------------------------------------------------------------------
# Scraper - Stale Listing Detection
# -----------------------------------------------------------------------

# Number of days after which a listing is considered stale.
# Shown as "Stale (90+ days)" in exports and admin panel.
SCRAPER_STALE_LISTING_DAYS=90

# -----------------------------------------------------------------------
# Scraper - Screenshots
# -----------------------------------------------------------------------

# Set true on production to capture new listing screenshots to B2.
# Keep false locally to avoid uploads during development.
SCREENSHOT_ACCESS_KEY=
SCRAPER_SCREENSHOTS_ENABLED=false

# Set true after making the b2_screenshots bucket public in Backblaze.
# Enables permanent screenshot URLs in Data Hub, Excel and AI responses.
SCREENSHOTS_PUBLIC=false

# -----------------------------------------------------------------------
# Scraper - Screenshot Capture
# -----------------------------------------------------------------------

# Max listings to screenshot per nightly run.
SCREENSHOT_DAILY_CHUNK=66


# -----------------------------------------------------------------------
# API Rate Limiting
# -----------------------------------------------------------------------

API_RATE_LIMIT=60
API_PER_TOKEN_LIMIT=30


# -----------------------------------------------------------------------
# Scraper - Drift Detection
# -----------------------------------------------------------------------

SCRAPER_DRIFT_MIN_LISTINGS=10
SCRAPER_DRIFT_MAX_NULL_RATE=0.5

# -----------------------------------------------------------------------
# Scraper - Cross-Poster Duplicate Detection
# -----------------------------------------------------------------------

# Flags (does not delete) probable duplicate listings - the same
# physical property posted by different parties under different
# external_ids. District/floor/rooms must match exactly; area and
# price are checked within these tolerances. See ATLAS.md for the
# real-data analysis these thresholds came from.
DUPLICATE_DETECTION_ENABLED=true
DUPLICATE_AREA_TOLERANCE_PERCENT=5.0
DUPLICATE_PRICE_TOLERANCE_PERCENT=10.0
DUPLICATE_AREA_TOLERANCE_PERCENT_STRICT=3.0
DUPLICATE_PRICE_TOLERANCE_PERCENT_STRICT=6.0

# -----------------------------------------------------------------------
# Exchange Rates (Fallback values used before atlas:fetch-exchange-rates runs)
# Approximate rates - overwritten daily by the scheduler from open.er-api.com
# -----------------------------------------------------------------------
FALLBACK_AMD_USD_RATE=0.00256
FALLBACK_AZN_USD_RATE=0.588
FALLBACK_GEL_USD_RATE=0.357
FALLBACK_EUR_USD_RATE=0.876

# -----------------------------------------------------------------------
# Sentry (Error Tracking)
# -----------------------------------------------------------------------

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------
# AI - Provider
# Atlas uses OpenRouter for all environments - routes to Anthropic,
# OpenAI, Google and others from a single API key.
# -----------------------------------------------------------------------

AI_DEFAULT_PROVIDER=openrouter
AI_PRODUCTION_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key-here


# -----------------------------------------------------------------------
# AI - Models
# agent: claude-haiku-4-5 - reliable tool-calling with optional parameters.
# text/tools: gemini-2.5-flash-lite - fast, cheap for text generation.
# embeddings: text-embedding-3-small - deferred to Thread 6 (RAG).
# vision: gemini-2.5-flash-lite - deferred to Thread 6 (PDF/image upload).
# -----------------------------------------------------------------------

AI_AGENT_MODEL=anthropic/claude-haiku-4-5
AI_TEXT_MODEL=anthropic/claude-haiku-4-5
AI_TOOLS_MODEL=google/gemini-2.5-flash-lite
AI_EMBEDDINGS_MODEL=openai/text-embedding-3-small
AI_VISION_MODEL=google/gemini-2.5-flash-lite

AI_FALLBACK_PRIMARY_MODEL=anthropic/claude-haiku-4-5
AI_FALLBACK_SECONDARY_MODEL=openrouter/auto


# -----------------------------------------------------------------------
# AI - Performance & Limits
# -----------------------------------------------------------------------

AI_CACHE_TTL=3600
AI_SEARCH_LIMIT=5
AI_MAX_TOKENS=4096
AI_RETRY_TIMES=3
AI_RETRY_SLEEP_MS=1000
AI_DEFAULT_SYSTEM_PROMPT="You are a real estate market intelligence assistant."


# -----------------------------------------------------------------------
# AI - Cost Controls
# CostAlertListener sends Telegram + email when a single call exceeds threshold.
# TokenBudgetService blocks calls when monthly token budget is exhausted.
# -----------------------------------------------------------------------

AI_COST_ALERT_THRESHOLD=0.01
AI_MONTHLY_TOKEN_BUDGET=1000000
AI_TOKEN_BUDGET_ENABLED=true


# -----------------------------------------------------------------------
# AI - Rate Limits (calls per hour per user)
# -----------------------------------------------------------------------

AI_RATE_LIMIT_CHAT=30
AI_RATE_LIMIT_TEXT=200
AI_RATE_LIMIT_EMBED=100
AI_RATE_LIMIT_ANALYSIS=20

# -----------------------------------------------------------------------
# AI - Translation
# Number of listings to translate per batch in TranslateNewListings job.
# Each listing makes one Claude API call - lower values reduce API pressure.
# -----------------------------------------------------------------------
TRANSLATION_CHUNK_SIZE=50


# -----------------------------------------------------------------------
# AI - Webhook
# HMAC-SHA256 secret for verifying incoming webhook requests.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------

WEBHOOK_SECRET=
WEBHOOK_MAX_FILE_SIZE_KB=10240

# -----------------------------------------------------------------------
# bina.az Baku Market
# Controls how many GraphQL cursor fetches BinazScraper runs per scrape.
# 1 fetch = 16 listings. Set high for initial backfill (80 = ~1,280 listings),
# reduce to 5 for ongoing daily runs after backfill is complete.
# -----------------------------------------------------------------------
BINAZ_LAND_SALE_MAX_PAGES=5
BINAZ_LAND_SALE_TIMEOUT=1800
BINAZ_LAND_SALE_SEA_BREEZE_MAX_PAGES=5
BINAZ_LAND_SALE_SEA_BREEZE_TIMEOUT=1800
BINAZ_OFFICES_SALE_MAX_PAGES=10
BINAZ_OFFICES_SALE_TIMEOUT=1800
BINAZ_OFFICES_RENT_MAX_PAGES=10
BINAZ_OFFICES_RENT_TIMEOUT=7200
BINAZ_APARTMENTS_SALE_MAX_PAGES=3310
BINAZ_APARTMENTS_SALE_TIMEOUT=14400
BINAZ_APARTMENTS_RENT_MAX_PAGES=1560
BINAZ_APARTMENTS_RENT_TIMEOUT=7200
BINAZ_HOUSES_SALE_MAX_PAGES=3
BINAZ_HOUSES_RENT_MAX_PAGES=3
BINAZ_HOUSES_SALE_TIMEOUT=1800
BINAZ_HOUSES_RENT_TIMEOUT=1800
BINAZ_COMMERCIAL_SALE_MAX_PAGES=10
BINAZ_COMMERCIAL_SALE_TIMEOUT=1800
BINAZ_COMMERCIAL_RENT_MAX_PAGES=10
BINAZ_COMMERCIAL_RENT_TIMEOUT=1800
MYHOME_APARTMENTS_SALE_MAX_PAGES=1
MYHOME_APARTMENTS_SALE_TIMEOUT=1800
MYHOME_APARTMENTS_SALE_CONCURRENCY=1
MYHOME_APARTMENTS_RENT_MAX_PAGES=1
MYHOME_APARTMENTS_RENT_TIMEOUT=1800
MYHOME_APARTMENTS_RENT_CONCURRENCY=1
MYHOME_HOUSES_SALE_MAX_PAGES=1
MYHOME_HOUSES_SALE_TIMEOUT=1800
MYHOME_HOUSES_SALE_CONCURRENCY=1
MYHOME_HOUSES_RENT_MAX_PAGES=1
MYHOME_HOUSES_RENT_TIMEOUT=1800
MYHOME_HOUSES_RENT_CONCURRENCY=1
MYHOME_COUNTRY_HOUSES_SALE_MAX_PAGES=1
MYHOME_COUNTRY_HOUSES_SALE_TIMEOUT=1800
MYHOME_COUNTRY_HOUSES_SALE_CONCURRENCY=1
MYHOME_COUNTRY_HOUSES_RENT_MAX_PAGES=1
MYHOME_COUNTRY_HOUSES_RENT_TIMEOUT=1800
MYHOME_COUNTRY_HOUSES_RENT_CONCURRENCY=1
MYHOME_LAND_SALE_MAX_PAGES=1
MYHOME_LAND_SALE_TIMEOUT=1800
MYHOME_LAND_SALE_CONCURRENCY=1
MYHOME_COMMERCIAL_SALE_MAX_PAGES=1
MYHOME_COMMERCIAL_SALE_TIMEOUT=1800
MYHOME_COMMERCIAL_SALE_CONCURRENCY=1
MYHOME_COMMERCIAL_RENT_MAX_PAGES=1
MYHOME_COMMERCIAL_RENT_TIMEOUT=1800
MYHOME_COMMERCIAL_RENT_CONCURRENCY=1

# -----------------------------------------------------------------------
# bina.az GraphQL Persisted Query Hash
# SHA256 hash identifying the SearchItems GraphQL query on bina.az frontend.
# This hash is tied to their frontend build and rotates when they deploy
# a new version. If GraphQL calls return field errors, update this value
# from DevTools: Network tab → SearchItems request → Payload → extensions.
# -----------------------------------------------------------------------
BINAZ_PERSISTED_QUERY_HASH=BINAZ_PERSISTED_QUERY_HASH=b781511a943a4d710eefdf811a24dd4ae353e55d836952603ce0b37fde97d073